[0:v]scale=-2:1920,crop=1080:1920,setsar=1,fps=30,drawbox=x=90:y=170:w=900:h=300:color=0xF7F1E4@0.94:t=fill,drawtext=fontfile='outputs/marketing/fonts/PlayfairDisplay-SemiBold.ttf':text='A whole round of golf...':fontcolor=0x193225:fontsize=70:x=(w-text_w)/2:y=235,drawtext=fontfile='outputs/marketing/fonts/DMSans-SemiBold.ttf':text='starts with a pen.':fontcolor=0x31543B:fontsize=52:x=(w-text_w)/2:y=355[intro];
